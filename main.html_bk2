<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <title>ARB – Run Trusted EXE via WebSocket</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      margin: 20px;
    }

    #log {
      border: 1px solid #ccc;
      padding: 10px;
      height: 300px;
      overflow: auto;
      background: #fafafa;
      white-space: pre-wrap;
    }

    button {
      margin-top: 10px;
    }

    .info {
      color: #0066cc;
    }

    .error {
      color: #cc0000;
    }

    .log {
      color: #006600;
    }

    .welcome {
      color: #333;
    }
  </style>
</head>

<body>
  <h2>ARB Live Stream Demo</h2>

  <div id="log"></div>

  <h3>Run a trusted internal tool</h3>
  <label>Parameter 1 (mandatory) : <input id="p1" type="text" placeholder="e.g. 12345"></label><br>
  <label>Mode (optional) :
    <select id="mode">
      <option value="">--none--</option>
      <option value="fast">fast</option>
      <option value="slow">slow</option>
    </select>
  </label><br>

  <button id="runBtn">Start MyTool</button>

  <script>
    const logDiv = document.getElementById('log');
    function addLine(txt, cssClass = '') {
      const span = document.createElement('span');
      span.textContent = txt + '\n';
      if (cssClass) span.className = cssClass;
      logDiv.appendChild(span);
      logDiv.scrollTop = logDiv.scrollHeight;
    }

    // -----------------------------------------------------------------
    // Adjust the address if the server runs on a different host/port.
    // -----------------------------------------------------------------
    const ws = new WebSocket('ws://localhost:8080/ws');

    ws.onopen = () => addLine('[INFO] WebSocket opened', 'info');
    ws.onclose = () => addLine('[INFO] WebSocket closed', 'info');
    ws.onerror = e => addLine('[ERROR] ' + e.message, 'error');

    ws.onmessage = ev => {
      try {
        const data = JSON.parse(ev.data);
        switch (data.type) {
          case 'welcome': addLine('[WELCOME] ' + data.message, 'welcome'); break;
          case 'info': addLine('[INFO] ' + data.message, 'info'); break;
          case 'error': addLine('[SERVER ERROR] ' + data.message, 'error'); break;
          case 'log': addLine('[EXE] ' + data.payload, 'log'); break;
          case 'update': addLine(`[UPDATE] ${data.timestamp} → ${data.value.toFixed(2)}`); break;
          default: addLine('[UNKNOWN] ' + ev.data); break;
        }
      } catch (_) {
        addLine('[RAW] ' + ev.data);
      }
    };

    document.getElementById('runBtn').onclick = () => {
      const p1 = document.getElementById('p1').value.trim();
      const mode = document.getElementById('mode').value;

      if (!p1) {
        addLine('[CLIENT] Parameter 1 is required', 'error');
        return;
      }

      const args = ['--workers', 10];
      args.push('--tpath', 'flowtemplates/IPS_outbound_Flow.json');
      args.push('--messages', '10');
      args.push('--strategy', 'duration');
      args.push('--per', 'all-workers')
      args.push('--duration', '90')
      args.push('--frqnc', '20')

      const request = {
        cmd: 'run',
        exe: 'mytool',   // must match a key in allowedExecutables on the server
        args: args
      };
      addLine('[CLIENT] Json: ' + JSON);
      ws.send(JSON.stringify(request));
      addLine('[CLIENT] Sent run request: ' + JSON.stringify(request), 'info');
    };
  </script>
</body>

</html>