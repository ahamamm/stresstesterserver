package main

import (
	"context"
	"flag"
	"log"
	"math/rand"
	"net/http"
	"os"
	"os/signal"
	"time"

	"github.com/gorilla/websocket"
)

// -------------------------------------------------------------------
// 1️⃣  WebSocket upgrader – tighten the origin check for production.
// -------------------------------------------------------------------
var upgrader = websocket.Upgrader{
	// Replace the lambda with a strict check e.g.
	// CheckOrigin: func(r *http.Request) bool {
	//     return strings.HasSuffix(r.Host, ".arb.com")
	// },
	CheckOrigin: func(r *http.Request) bool { return true },
}

// -------------------------------------------------------------------
// 2️⃣  Message structures – feel free to extend.
// -------------------------------------------------------------------
type welcomeMsg struct {
	Type    string `json:"type"`    // "welcome"
	Message string `json:"message"` // human readable
}

type streamMsg struct {
	Type      string  `json:"type"`      // "update"
	Timestamp string  `json:"timestamp"` // ISO‑8601
	Value     float64 `json:"value"`     // example payload
}

// -------------------------------------------------------------------
// 3️⃣  WebSocket handler – sends welcome, streams data, and reads.
// -------------------------------------------------------------------
func wsHandler(w http.ResponseWriter, r *http.Request) {
	// ==== Upgrade HTTP → WebSocket ====
	conn, err := upgrader.Upgrade(w, r, nil)
	if err != nil {
		log.Printf("[ERROR] Upgrade failed: %v", err)
		return
	}
	defer func() {
		_ = conn.Close()
		log.Printf("[INFO] Closed connection from %s", r.RemoteAddr)
	}()

	log.Printf("[INFO] New client %s", r.RemoteAddr)

	// ==== 3.1 Send a welcome / acknowledgment message ====
	welcome := welcomeMsg{
		Type:    "welcome",
		Message: "Connected to ARB live‑stream service",
	}
	if err := conn.WriteJSON(welcome); err != nil {
		log.Printf("[ERROR] Write welcome: %v", err)
		return
	}

	// ==== 3.2 Context that is canceled when the client disconnects ====
	ctx, cancel := context.WithCancel(context.Background())
	defer cancel()

	// ==== 3.3 Read pump – listens for inbound messages (optional) ====
	go func() {
		defer cancel() // any read error shuts down the whole connection
		for {
			msgType, payload, err := conn.ReadMessage()
			if err != nil {
				if websocket.IsUnexpectedCloseError(err,
					websocket.CloseGoingAway,
					websocket.CloseNormalClosure) {
					log.Printf("[ERROR] Unexpected read error: %v", err)
				} else {
					log.Printf("[INFO] Client %s closed the connection", r.RemoteAddr)
				}
				return
			}

			// Optional: acknowledge the received message
			ack := map[string]interface{}{
				"type":    "ack",
				"payload": string(payload),
			}
			if err := conn.WriteJSON(ack); err != nil {
				log.Printf("[ERROR] Send ACK: %v", err)
				return
			}

			// If you need to act on the client payload, do it here.
			// Example: if msgType == websocket.TextMessage { … }
			_ = msgType // currently unused
		}
	}()

	// ==== 3.4 Stream pump – pushes data periodically ====
	ticker := time.NewTicker(1 * time.Second) // change interval as needed
	defer ticker.Stop()

	for {
		select {
		case <-ctx.Done():
			// client disconnected → stop the stream
			return
		case t := <-ticker.C:
			// Build a sample payload – replace with your real data source.
			update := streamMsg{
				Type:      "update",
				Timestamp: t.UTC().Format(time.RFC3339),
				Value:     rand.Float64() * 100, // dummy metric
			}

			// WriteJSON sets a proper WriteDeadline internally.
			if err := conn.WriteJSON(update); err != nil {
				log.Printf("[ERROR] Stream write error: %v", err)
				return
			}
		}
	}
}

// -------------------------------------------------------------------
// 4️⃣  Main – HTTP server + graceful shutdown
// -------------------------------------------------------------------
func main() {
	// ---- Configurable flags -------------------------------------------------
	addr := flag.String("addr", ":8080", "TCP address to listen on")
	shutdownTO := flag.Duration("shutdown-timeout", 10*time.Second,
		"Graceful shutdown timeout")
	flag.Parse()

	// ---- Router -------------------------------------------------------------
	mux := http.NewServeMux()
	mux.HandleFunc("/ws", wsHandler)

	// Optional health‑check endpoint (useful for load‑balancers)
	mux.HandleFunc("/healthz", func(w http.ResponseWriter, r *http.Request) {
		w.WriteHeader(http.StatusOK)
		_, _ = w.Write([]byte("OK"))
	})

	srv := &http.Server{
		Addr:              *addr,
		Handler:           mux,
		ReadHeaderTimeout: 5 * time.Second,
		WriteTimeout:      10 * time.Second,
		IdleTimeout:       60 * time.Second,
	}

	// ---- Run server in background -------------------------------------------
	go func() {
		log.Printf("[INFO] WebSocket server listening on %s", *addr)
		if err := srv.ListenAndServe(); err != nil && err != http.ErrServerClosed {
			log.Fatalf("[FATAL] ListenAndServe: %v", err)
		}
	}()

	// ---- Graceful shutdown ---------------------------------------------------
	stop := make(chan os.Signal, 1)
	signal.Notify(stop, os.Interrupt) // add syscall.SIGTERM for containers
	<-stop
	log.Println("[INFO] Shutdown signal received")

	ctx, cancel := context.WithTimeout(context.Background(), *shutdownTO)
	defer cancel()
	if err := srv.Shutdown(ctx); err != nil {
		log.Fatalf("[FATAL] Server forced to shutdown: %v", err)
	}
	log.Println("[INFO] Server stopped gracefully")
}
